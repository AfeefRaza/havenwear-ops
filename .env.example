# Copy to .env.local for local development. NEVER commit real values.
# Only the public Supabase URL and the anon/publishable key belong in the frontend.
# The service_role / sb_secret key must NEVER be placed here or anywhere in this repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Path the app is served from (GitHub Pages: /<repo-name>/). Use / for local dev.
VITE_BASE=/
